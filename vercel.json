{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/inicio", "destination": "/Marilia%20Magazine.dc.html" },
    { "source": "/catalogo", "destination": "/Catalogo.dc.html" },
    { "source": "/producto", "destination": "/Producto.dc.html" },
    { "source": "/privacidad", "destination": "/Privacidad.dc.html" }
  ],
  "headers": [
    {
      "source": "/uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
